# Use mock providers for a no-credential hackathon demo.
AUDIO_PROVIDER_MODE=mock
ANALYSIS_PROVIDER_MODE=mock

# Required only when AUDIO_PROVIDER_MODE=elevenlabs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Use "nvidia" for the hosted NVIDIA chat-completions API, or "remote" for a
# team-hosted adapter that already implements docs/integration-contract.md.
NEMOTRON_API_URL=
NEMOTRON_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Hackathon limits.
AUDIO_MAX_SECONDS=30
AUDIO_MAX_BYTES=30000000
MOCK_STT_TEXT=If you confess, I can make sure you go home tonight.
