# Streamlit live monitor uses ElevenLabs STT/TTS when a key is present.
AUDIO_PROVIDER_MODE=elevenlabs
ANALYSIS_PROVIDER_MODE=mock

# Required only when AUDIO_PROVIDER_MODE=elevenlabs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Required only when ANALYSIS_PROVIDER_MODE=remote.
NEMOTRON_API_URL=
NEMOTRON_API_KEY=

# Josh's NVIDIA Nemotron client (optional; local classifier runs without these).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=

# Hackathon limits.
AUDIO_MAX_SECONDS=30
AUDIO_MAX_BYTES=30000000
MOCK_STT_TEXT=If you confess, I can make sure you go home tonight.

